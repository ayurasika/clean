# ===== サーバー側だけで使う（Vercel の Environment Variables に設定）=====
# Gemini の API キー（VITE_ で始まらない名前にすること。VITE_GEMINI_API_KEY も互換で読むが非推奨）
GEMINI_API_KEY=

# 利用回数の記録先（Upstash Redis の REST URL / TOKEN）。未設定だと制限が信頼できない
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 許可するサイトのURL（カンマ区切りで複数可）。未設定なら https://clean-rosy.vercel.app
ALLOWED_ORIGIN=https://clean-rosy.vercel.app

# IP をハッシュ化するときの秘密の文字列（任意・適当な長い文字列）
RATE_LIMIT_SALT=

# ===== 1日あたりの上限（未設定なら右の値）=====
# LIMIT_FLASH_PER_DAY=50
# LIMIT_PRO_PER_DAY=10
# LIMIT_INSPECTION_PER_DAY=100
# LIMIT_RETRY_PER_DAY=50
# LIMIT_TEXT_PER_DAY=300
# LIMIT_IP_IMAGE_PER_DAY=5
# LIMIT_IP_TEXT_PER_DAY=40
